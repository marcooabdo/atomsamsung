# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps Configuration
# Obtain your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Distance Matrix API, Directions API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ElevenLabs Configuration (Voice for GIA)
# Obtain your API key from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=your_voice_id_here
